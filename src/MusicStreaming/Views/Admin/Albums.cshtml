@model IEnumerable<MusicStreaming.Models.Album>

@{
    ViewData["Title"] = "Quản lý Album";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 pt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white fw-bold">Quản lý Album</h2>
        <a asp-action="CreateAlbum" class="btn btn-primary rounded-pill px-4">
            <i class="fas fa-plus me-2"></i> Thêm Album
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="bg-secondary text-uppercase small text-muted">
                        <tr>
                            <th class="ps-4">Ảnh bìa</th>
                            <th>Tên Album</th>
                            <th>Nghệ sĩ</th>
                            <th>Ngày phát hành</th>
                            <th class="text-end pe-4">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <img src="@(string.IsNullOrEmpty(item.CoverImageUrl) ? "/images/albums/default.jpg" : item.CoverImageUrl)" 
                                         class="rounded" width="50" height="50" style="object-fit: cover;" alt="Cover">
                                </td>
                                <td class="fw-bold">@item.AlbumName</td>
                                <td>@(item.Artist?.ArtistName ?? "-")</td>
                                <td>@(item.ReleaseDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="text-end pe-4">
                                    <a asp-action="EditAlbum" asp-route-id="@item.AlbumId" class="btn btn-sm btn-outline-info me-2">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="DeleteAlbum" asp-route-id="@item.AlbumId" method="post" class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa album này?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
