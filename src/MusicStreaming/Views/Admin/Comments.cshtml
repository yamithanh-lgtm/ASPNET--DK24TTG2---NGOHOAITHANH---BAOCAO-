@model IEnumerable<MusicStreaming.Models.Comment>

@{
    ViewData["Title"] = "Quản lý bình luận";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-comments text-primary me-2"></i> Quản lý bình luận</h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Người dùng</th>
                            <th>Bài hát</th>
                            <th>Nội dung</th>
                            <th>Ngày đăng</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <img src="@(item.User?.AvatarUrl ?? "/images/avatars/default.png")" 
                                             class="rounded-circle me-2" width="32" height="32" style="object-fit: cover;">
                                        <div>
                                            <div class="fw-bold">@item.User?.Username</div>
                                            <div class="small text-muted">@item.User?.FullName</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@item.Song?.SongName</span>
                                </td>
                                <td>
                                    <p class="mb-0 text-break" style="max-width: 300px;">@item.Content</p>
                                </td>
                                <td>@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end pe-4">
                                    <form asp-action="DeleteComment" asp-route-id="@item.CommentId" method="post" class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa bình luận này?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted">Chưa có bình luận nào.</p>
                </div>
            }
        </div>
    </div>
</div>
