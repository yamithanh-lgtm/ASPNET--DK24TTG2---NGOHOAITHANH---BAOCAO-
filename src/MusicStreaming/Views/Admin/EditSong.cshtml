@model MusicStreaming.Models.Song

@{
    ViewData["Title"] = "Chỉnh sửa bài hát";
    var artists = ViewBag.Artists as List<MusicStreaming.Models.Artist>;
    var genres = ViewBag.Genres as List<MusicStreaming.Models.Genre>;
    var albums = ViewBag.Albums as List<MusicStreaming.Models.Album>;
}

<div class="container mt-4">
    <div class="section-header mb-4">
        <div>
            <h1 class="section-title"><i class="fas fa-edit"></i> Chỉnh sửa bài hát</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Songs">Bài hát</a></li>
                    <li class="breadcrumb-item active">Chỉnh sửa</li>
                </ol>
            </nav>
        </div>
    </div>

    <form asp-action="EditSong" method="post" enctype="multipart/form-data" id="editSongForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SongId" value="@Model.SongId" />
        <input type="hidden" name="AudioFileUrl" value="@Model.AudioFileUrl" />
        <input type="hidden" name="CoverImageUrl" value="@Model.CoverImageUrl" />

        <div class="row">
            <!-- Left Column - Main Info -->
            <div class="col-lg-8">
                <div class="card glass-effect mb-4">
                    <div class="card-header bg-transparent border-secondary">
                        <h5 class="mb-0"><i class="fas fa-info-circle"></i> Thông tin bài hát</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="SongName" class="form-label">
                                Tên bài hát <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="SongName" name="SongName" 
                                   value="@Model.SongName" required autofocus>
                            <span asp-validation-for="SongName" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="ArtistId" class="form-label">
                                    Nghệ sĩ <span class="text-danger">*</span>
                                </label>
                                <select class="form-select" id="ArtistId" name="ArtistId" required>
                                    <option value="">-- Chọn nghệ sĩ --</option>
                                    @if (artists != null)
                                    {
                                        foreach (var artist in artists)
                                        {
                                            <!option value="@artist.ArtistId" @(Model.ArtistId == artist.ArtistId ? "selected" : "")>
                                                @artist.ArtistName
                                            </!option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="ArtistId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="GenreId" class="form-label">Thể loại</label>
                                <select class="form-select" id="GenreId" name="GenreId">
                                    <option value="">-- Chọn thể loại --</option>
                                    @if (genres != null)
                                    {
                                        foreach (var genre in genres)
                                        {
                                            <!option value="@genre.GenreId" @(Model.GenreId == genre.GenreId ? "selected" : "")>
                                                @genre.GenreName
                                            </!option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="AlbumId" class="form-label">Album</label>
                                <select class="form-select" id="AlbumId" name="AlbumId">
                                    <option value="">-- Chọn album --</option>
                                    @if (albums != null)
                                    {
                                        foreach (var album in albums)
                                        {
                                            <!option value="@album.AlbumId" @(Model.AlbumId == album.AlbumId ? "selected" : "")>
                                                @album.AlbumName
                                            </!option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="Duration" class="form-label">Thời lượng</label>
                                <input type="text" class="form-control" id="Duration" name="Duration" 
                                       value="@Model.Duration" placeholder="VD: 03:45">
                                <small class="text-muted">Định dạng: mm:ss</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="ReleaseDate" class="form-label">Ngày phát hành</label>
                            <input type="date" class="form-control" id="ReleaseDate" name="ReleaseDate"
                                   value="@(Model.ReleaseDate?.ToString("yyyy-MM-dd"))">
                        </div>

                        <div class="mb-3">
                            <label for="Lyrics" class="form-label">Lời bài hát</label>
                            <textarea class="form-control" id="Lyrics" name="Lyrics" rows="8" 
                                      placeholder="Nhập lời bài hát...">@Model.Lyrics</textarea>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            <strong>Thống kê:</strong> 
                            Lượt nghe: <strong>@Model.PlayCount.ToString("N0")</strong> | 
                            Ngày tạo: <strong>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column - Files -->
            <div class="col-lg-4">
                <!-- Current Audio -->
                <div class="card glass-effect mb-4">
                    <div class="card-header bg-transparent border-secondary">
                        <h5 class="mb-0"><i class="fas fa-file-audio"></i> File âm thanh</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.AudioFileUrl))
                        {
                            <div class="mb-3">
                                <p class="text-muted mb-2">File hiện tại:</p>
                                <audio controls class="w-100">
                                    <source src="@Model.AudioFileUrl" type="audio/mpeg">
                                    Trình duyệt không hỗ trợ audio.
                                </audio>
                            </div>
                        }

                        <div class="mb-3">
                            <label for="audioFile" class="form-label">
                                @(string.IsNullOrEmpty(Model.AudioFileUrl) ? "Upload file audio" : "Thay đổi file audio")
                            </label>
                            <input type="file" class="form-control" id="audioFile" name="audioFile" 
                                   accept="audio/*" onchange="previewAudio(this)">
                            <small class="text-muted">MP3, WAV, OGG. Tối đa 100MB</small>
                        </div>

                        <div id="audioPreview" style="display: none;">
                            <p class="text-muted mb-2">Xem trước file mới:</p>
                            <audio id="audioPlayer" controls class="w-100"></audio>
                        </div>
                    </div>
                </div>

                <!-- Current Cover Image -->
                <div class="card glass-effect mb-4">
                    <div class="card-header bg-transparent border-secondary">
                        <h5 class="mb-0"><i class="fas fa-image"></i> Ảnh bìa</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                        {
                            <div class="mb-3">
                                <p class="text-muted mb-2">Ảnh hiện tại:</p>
                                <img src="@Model.CoverImageUrl" alt="@Model.SongName" 
                                     class="img-fluid rounded" id="currentImage">
                            </div>
                        }

                        <div class="mb-3">
                            <label for="coverImage" class="form-label">
                                @(string.IsNullOrEmpty(Model.CoverImageUrl) ? "Upload ảnh bìa" : "Thay đổi ảnh bìa")
                            </label>
                            <input type="file" class="form-control" id="coverImage" name="coverImage" 
                                   accept="image/*" onchange="previewImage(this)">
                            <small class="text-muted">JPG, PNG. Tối đa 5MB</small>
                        </div>

                        <div id="imagePreview" style="display: none;">
                            <p class="text-muted mb-2">Xem trước ảnh mới:</p>
                            <img id="preview" src="" alt="Preview" class="img-fluid rounded">
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="card glass-effect">
                    <div class="card-body">
                        <button type="submit" class="btn btn-warning w-100 mb-2">
                            <i class="fas fa-save"></i> Cập nhật
                        </button>
                        <a asp-action="Songs" class="btn btn-outline-secondary w-100">
                            <i class="fas fa-times"></i> Hủy
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            const preview = document.getElementById('preview');
            const previewContainer = document.getElementById('imagePreview');
            const currentImage = document.getElementById('currentImage');
            
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    previewContainer.style.display = 'block';
                    if (currentImage) currentImage.style.opacity = '0.5';
                }
                reader.readAsDataURL(input.files[0]);
            } else {
                previewContainer.style.display = 'none';
                if (currentImage) currentImage.style.opacity = '1';
            }
        }

        function previewAudio(input) {
            const audioPlayer = document.getElementById('audioPlayer');
            const previewContainer = document.getElementById('audioPreview');
            
            if (input.files && input.files[0]) {
                const url = URL.createObjectURL(input.files[0]);
                audioPlayer.src = url;
                previewContainer.style.display = 'block';
            } else {
                previewContainer.style.display = 'none';
            }
        }

        // Form validation
        document.getElementById('editSongForm').addEventListener('submit', function(e) {
            const audioFile = document.getElementById('audioFile').files[0];
            const coverImage = document.getElementById('coverImage').files[0];

            // Check audio file size (100MB)
            if (audioFile && audioFile.size > 100 * 1024 * 1024) {
                e.preventDefault();
                alert('File audio quá lớn! Vui lòng chọn file nhỏ hơn 100MB.');
                return false;
            }

            // Check image file size (5MB)
            if (coverImage && coverImage.size > 5 * 1024 * 1024) {
                e.preventDefault();
                alert('File ảnh quá lớn! Vui lòng chọn file nhỏ hơn 5MB.');
                return false;
            }
        });
    </script>
}

<style>
    .breadcrumb {
        background: transparent;
        padding: 0;
        margin: 0;
    }
    
    .breadcrumb-item a {
        color: var(--primary-color);
        text-decoration: none;
    }
    
    .breadcrumb-item.active {
        color: rgba(255, 255, 255, 0.7);
    }

    .form-control:focus,
    .form-select:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 0.2rem rgba(29, 185, 84, 0.25);
    }

    #preview,
    #currentImage {
        max-height: 300px;
        border: 2px solid var(--primary-color);
        transition: opacity 0.3s ease;
    }
</style>
