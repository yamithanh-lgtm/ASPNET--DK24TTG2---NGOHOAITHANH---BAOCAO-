@{
    ViewData["Title"] = "Quản trị";
    var totalSongs = ViewBag.TotalSongs ?? 0;
    var totalUsers = ViewBag.TotalUsers ?? 0;
    var totalPlaylists = ViewBag.TotalPlaylists ?? 0;
    var totalArtists = ViewBag.TotalArtists ?? 0;
    var recentSongs = ViewBag.RecentSongs as List<MusicStreaming.Models.Song>;
}

<div class="container mt-4">
    <div class="section-header mb-4">
        <div>
            <h1 class="section-title fw-bold"><i class="fas fa-cog text-primary"></i> Quản trị hệ thống</h1>
            <p class="text-muted">Chào mừng, @Context.Session.GetString("Username")!</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card glass-effect text-center h-100 border-0 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-music fa-3x mb-3" style="color: var(--primary-color);"></i>
                    <h3 class="mb-0 fw-bold">@totalSongs</h3>
                    <p class="text-muted mb-0">Bài hát</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card glass-effect text-center h-100 border-0 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-users fa-3x mb-3" style="color: #3498db;"></i>
                    <h3 class="mb-0 fw-bold">@totalUsers</h3>
                    <p class="text-muted mb-0">Người dùng</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card glass-effect text-center h-100 border-0 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-list fa-3x mb-3" style="color: #e74c3c;"></i>
                    <h3 class="mb-0 fw-bold">@totalPlaylists</h3>
                    <p class="text-muted mb-0">Playlists</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card glass-effect text-center h-100 border-0 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-microphone fa-3x mb-3" style="color: #f39c12;"></i>
                    <h3 class="mb-0 fw-bold">@totalArtists</h3>
                    <p class="text-muted mb-0">Nghệ sĩ</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <a asp-action="CreateSong" class="card glass-effect text-decoration-none h-100 border-0 shadow-sm hover-card">
                <div class="card-body text-center">
                    <i class="fas fa-plus-circle fa-3x mb-3" style="color: var(--primary-color);"></i>
                    <h5 class="text-dark">Thêm bài hát mới</h5>
                    <p class="text-muted mb-0">Upload bài hát và ảnh bìa</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-action="CreateArtist" class="card glass-effect text-decoration-none h-100 border-0 shadow-sm hover-card">
                <div class="card-body text-center">
                    <i class="fas fa-user-plus fa-3x mb-3" style="color: #3498db;"></i>
                    <h5 class="text-dark">Thêm nghệ sĩ mới</h5>
                    <p class="text-muted mb-0">Quản lý thông tin nghệ sĩ</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-action="Users" class="card glass-effect text-decoration-none h-100 border-0 shadow-sm hover-card">
                <div class="card-body text-center">
                    <i class="fas fa-users-cog fa-3x mb-3" style="color: #e74c3c;"></i>
                    <h5 class="text-dark">Quản lý người dùng</h5>
                    <p class="text-muted mb-0">Xem và quản lý tài khoản</p>
                </div>
            </a>
        </div>
    </div>

    <!-- Management Links -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card glass-effect border-0 shadow-sm">
                <div class="card-body">
                    <h4 class="mb-3 fw-bold text-dark"><i class="fas fa-tasks me-2"></i> Quản lý nội dung</h4>
                    <div class="list-group list-group-flush">
                        <a asp-action="Songs" class="list-group-item list-group-item-action border-0 d-flex align-items-center">
                            <i class="fas fa-music me-3 text-secondary" style="width: 20px;"></i> Quản lý bài hát
                        </a>
                        <a asp-action="Artists" class="list-group-item list-group-item-action border-0 d-flex align-items-center">
                            <i class="fas fa-microphone me-3 text-secondary" style="width: 20px;"></i> Quản lý nghệ sĩ
                        </a>
                        <a asp-action="Albums" class="list-group-item list-group-item-action border-0 d-flex align-items-center">
                            <i class="fas fa-compact-disc me-3 text-secondary" style="width: 20px;"></i> Quản lý album
                        </a>
                        <a asp-action="Genres" class="list-group-item list-group-item-action border-0 d-flex align-items-center">
                            <i class="fas fa-tags me-3 text-secondary" style="width: 20px;"></i> Quản lý thể loại
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card glass-effect border-0 shadow-sm">
                <div class="card-body">
                    <h4 class="mb-3 fw-bold text-dark"><i class="fas fa-chart-line me-2"></i> Báo cáo & Thống kê</h4>
                    <div class="list-group list-group-flush">
                        <a href="#" class="list-group-item list-group-item-action border-0 d-flex align-items-center">
                            <i class="fas fa-chart-bar me-3 text-secondary" style="width: 20px;"></i> Thống kê lượt nghe
                        </a>
                        <a href="#" class="list-group-item list-group-item-action border-0 d-flex align-items-center">
                            <i class="fas fa-star me-3 text-secondary" style="width: 20px;"></i> Top bài hát
                        </a>
                        <a asp-action="Comments" class="list-group-item list-group-item-action border-0 d-flex align-items-center">
                            <i class="fas fa-comments me-3 text-secondary" style="width: 20px;"></i> Quản lý bình luận
                        </a>
                        <a asp-action="Users" class="list-group-item list-group-item-action border-0 d-flex align-items-center">
                            <i class="fas fa-users me-3 text-secondary" style="width: 20px;"></i> Quản lý người dùng
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Songs -->
    @if (recentSongs != null && recentSongs.Any())
    {
        <div class="card glass-effect border-0 shadow-sm">
            <div class="card-body">
                <h4 class="mb-4 fw-bold text-dark"><i class="fas fa-clock me-2"></i> Bài hát mới thêm gần đây</h4>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th>Tên bài hát</th>
                                <th>Nghệ sĩ</th>
                                <th>Thể loại</th>
                                <th>Lượt nghe</th>
                                <th>Ngày tạo</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var song in recentSongs)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@(song.CoverImageUrl ?? "/images/default-cover.jpg")" 
                                                 alt="@song.SongName" 
                                                 class="rounded shadow-sm"
                                                 style="width: 40px; height: 40px; margin-right: 10px; object-fit: cover;">
                                            <span class="fw-bold">@song.SongName</span>
                                        </div>
                                    </td>
                                    <td>@song.Artist?.ArtistName</td>
                                    <td>@song.Genre?.GenreName</td>
                                    <td>@song.PlayCount.ToString("N0")</td>
                                    <td>@song.CreatedDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">
                                        <a asp-action="EditSong" asp-route-id="@song.SongId" class="btn btn-sm btn-outline-primary me-2" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="DeleteSong" asp-route-id="@song.SongId" method="post" style="display: inline;" 
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài hát này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .hover-card {
        transition: transform 0.2s;
    }
    .hover-card:hover {
        transform: translateY(-5px);
    }
    .list-group-item {
        background: transparent;
        color: var(--text-primary);
    }
    .list-group-item:hover {
        background: rgba(0,0,0,0.03) !important;
        color: var(--primary-color);
    }
</style>
