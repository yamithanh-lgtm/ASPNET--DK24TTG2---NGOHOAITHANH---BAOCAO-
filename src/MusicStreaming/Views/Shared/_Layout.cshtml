<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MusicStream</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Modern Navbar -->
    <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand me-5" asp-controller="Home" asp-action="Index">
                <i class="fab fa-spotify fa-lg"></i> MusicStream
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <!-- Main Navigation -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" 
                           asp-controller="Home" asp-action="Index">
                            <i class="fas fa-home"></i> Trang chủ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Songs" ? "active" : "")" 
                           asp-controller="Songs" asp-action="Index">
                            <i class="fas fa-search"></i> Khám phá
                        </a>
                    </li>
                    @if (Context.Session.GetInt32("UserId").HasValue)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Playlists" ? "active" : "")" 
                               asp-controller="Playlists" asp-action="Index">
                                <i class="fas fa-book"></i> Thư viện
                            </a>
                        </li>
                    }
                    @if (Context.Session.GetString("Role") == "Admin")
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")" 
                               asp-controller="Admin" asp-action="Index">
                                <i class="fas fa-shield-alt"></i> Quản trị
                            </a>
                        </li>
                    }
                </ul>

                <!-- Search Bar -->
                <form class="d-flex me-4" asp-controller="Songs" asp-action="Index" method="get">
                    <div class="search-container">
                        <i class="fas fa-search search-icon"></i>
                        <input class="search-input" type="search" name="search" placeholder="Bạn muốn nghe gì?" aria-label="Search">
                    </div>
                </form>

                <!-- User Menu -->
                <ul class="navbar-nav">
                    @if (Context.Session.GetInt32("UserId").HasValue)
                    {
                        <li class="nav-item dropdown">
                            <a class="user-menu-btn dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                                <img src="@(Context.Session.GetString("AvatarUrl") ?? "/images/avatars/default.png")" class="user-avatar-small" alt="Avatar">
                                <span class="fw-bold small">@(Context.Session.GetString("FullName") ?? Context.Session.GetString("Username"))</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-custom dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                        <i class="fas fa-user me-2"></i> Hồ sơ
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Playlists" asp-action="Index">
                                        <i class="fas fa-list me-2"></i> Playlist của tôi
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
                                        <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-2">
                            <a class="nav-link fw-bold text-dark" asp-controller="Account" asp-action="Register">
                                Đăng ký
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary px-4" asp-controller="Account" asp-action="Login">
                                Đăng nhập
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main role="main" class="main-content">
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <!-- Music Player (Fixed Bottom) -->
    <div id="musicPlayer" class="music-player flex-column justify-content-center" style="display: none;">
        <button id="btnClosePlayer" class="btn btn-sm text-secondary position-absolute top-0 end-0 mt-2 me-3" style="z-index: 1001;" title="Thu nhỏ">
            <i class="fas fa-chevron-down"></i>
        </button>
        
        <!-- Timeline on Top (Explicit Order 1) -->
        <div class="w-100 px-3 pt-2 order-1 d-flex justify-content-center">
            <div class="player-progress" style="width: 100%; max-width: 700px;">
                <span id="currentTime" style="min-width: 45px; text-align: right;">0:00</span>
                <input type="range" class="progress-bar mx-2" id="progressBar" min="0" max="100" value="0">
                <span id="duration" style="min-width: 45px;">0:00</span>
            </div>
        </div>

        <!-- Controls & Info on Bottom (Explicit Order 2) -->
        <div class="container-fluid px-4 pb-2 flex-grow-1 d-flex align-items-center order-2">
            <div class="row align-items-center w-100 m-0">
                <!-- Song Info -->
                <div class="col-md-3 px-0">
                    <div class="d-flex align-items-center">
                        <img id="playerCover" src="" alt="Cover" class="player-cover shadow-sm">
                        <div class="ms-3 overflow-hidden">
                            <div id="playerSongName" class="player-song-name text-truncate"></div>
                            <div id="playerArtistName" class="player-artist-name text-truncate"></div>
                        </div>
                        <button class="btn btn-link text-secondary ms-3" id="btnLikePlayer">
                            <i class="far fa-heart"></i>
                        </button>
                    </div>
                </div>

                <!-- Controls -->
                <div class="col-md-6">
                    <div class="player-controls mb-0">
                        <button class="btn-player" id="btnShuffle" title="Trộn bài"><i class="fas fa-random"></i></button>
                        <button class="btn-player" id="btnPrevious"><i class="fas fa-step-backward"></i></button>
                        <button class="btn-player btn-play" id="btnPlayPause">
                            <i class="fas fa-play"></i>
                        </button>
                        <button class="btn-player" id="btnNext"><i class="fas fa-step-forward"></i></button>
                        <button class="btn-player" id="btnRepeat" title="Lặp lại"><i class="fas fa-redo"></i></button>
                    </div>
                </div>

                <!-- Volume -->
                <div class="col-md-3 px-0">
                    <div class="d-flex align-items-center justify-content-end">
                        <button class="btn-player me-2" id="btnVolume"><i class="fas fa-volume-up"></i></button>
                        <input type="range" class="volume-bar" id="volumeBar" min="0" max="100" value="70" style="width: 100px;">
                    </div>
                </div>
            </div>
        </div>
        <audio id="audioPlayer"></audio>
    </div>

    <!-- Restore Player Button -->
    <button id="btnRestorePlayer" class="btn btn-primary rounded-circle shadow-lg position-fixed bottom-0 end-0 m-4 animate-bounce" 
            style="width: 50px; height: 50px; z-index: 1002; display: none; align-items: center; justify-content: center;" title="Mở trình phát nhạc">
        <i class="fas fa-compact-disc fa-spin" style="font-size: 1.5rem;"></i>
    </button>

    <!-- Footer -->
    <footer class="footer mt-auto py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="mb-3 fw-bold"><i class="fab fa-spotify me-2 text-primary"></i> MusicStream</h5>
                    <p class="small text-muted">Nền tảng nghe nhạc trực tuyến hàng đầu Việt Nam. Thưởng thức âm nhạc chất lượng cao mọi lúc, mọi nơi.</p>
                </div>
                <div class="col-md-2">
                    <h6 class="text-uppercase small fw-bold mb-3">Công ty</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#" class="text-decoration-none">Về chúng tôi</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none">Việc làm</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none">For the Record</a></li>
                    </ul>
                </div>
                <div class="col-md-2">
                    <h6 class="text-uppercase small fw-bold mb-3">Cộng đồng</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#" class="text-decoration-none">Dành cho Nghệ sĩ</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none">Nhà phát triển</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none">Quảng cáo</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-uppercase small fw-bold mb-3">Mạng xã hội</h6>
                    <div class="d-flex gap-3">
                        <a href="#" class="btn btn-light border rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="fab fa-instagram text-secondary"></i>
                        </a>
                        <a href="#" class="btn btn-light border rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="fab fa-twitter text-secondary"></i>
                        </a>
                        <a href="#" class="btn btn-light border rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="fab fa-facebook-f text-secondary"></i>
                        </a>
                    </div>
                </div>
            </div>
            <hr class="my-4">
            <div class="d-flex justify-content-between small text-muted">
                <p>&copy; 2025 MusicStream. All rights reserved.</p>
                <div>
                    <a href="#" class="text-decoration-none text-muted me-3">Chính sách bảo mật</a>
                    <a href="#" class="text-decoration-none text-muted">Điều khoản sử dụng</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/player.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
