@model List<MusicStreaming.Models.Song>
@{
    ViewData["Title"] = "Danh sách bài hát";
    var genres = ViewBag.Genres as List<MusicStreaming.Models.Genre>;
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var search = ViewBag.Search as string;
    var genreId = ViewBag.GenreId as int?;
}

<div class="container mt-4 song-list-page">
    <!-- Header -->
    <div class="section-header">
        <div>
            <h1 class="section-title">Danh sách bài hát</h1>
            <p class="section-subtitle">Khám phá hàng ngàn bài hát từ các nghệ sĩ yêu thích</p>
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-4 g-2 align-items-center">
        <div class="col-md-8">
            <form method="get" class="d-flex gap-2">
                <input type="text" name="search"
                       class="form-control filter-input"
                       placeholder="Tìm kiếm bài hát, nghệ sĩ..."
                       value="@search">

                <button type="submit" class="btn btn-primary filter-btn">
                    <i class="fas fa-search"></i> Tìm kiếm
                </button>
            </form>
        </div>

        <div class="col-md-4">
            <form method="get">
                <select name="genreId" class="form-select filter-select"
                        onchange="this.form.submit()">
                    <option value="">Tất cả thể loại</option>
                    @if (genres != null)
                    {
                        foreach (var genre in genres)
                        {
                            <option value="@genre.GenreId" selected="@(genreId == genre.GenreId)">
                                @genre.GenreName
                            </option>
                        }
                    }
                </select>

                @if (!string.IsNullOrEmpty(search))
                {
                    <input type="hidden" name="search" value="@search" />
                }
            </form>
        </div>
    </div>


    <!-- Songs List -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var song in Model)
            {
                <div class="col-md-6 col-lg-4 fade-in">
                    <div class="card">
                        <img src="@(song.CoverImageUrl ?? "/images/default-cover.jpg")" class="card-img-top" alt="@song.SongName">
                        <div class="card-body">
                            <h5 class="card-title">@song.SongName</h5>
                            <p class="card-text">
                                <i class="fas fa-user"></i> @song.Artist?.ArtistName<br>
                                <i class="fas fa-music"></i> @song.Genre?.GenreName<br>
                                <i class="fas fa-play"></i> @song.PlayCount.ToString("N0") lượt nghe
                            </p>
                            <div class="d-flex gap-2">
                                <button class="btn btn-primary flex-grow-1" onclick="playSong(@song.SongId, '@song.SongName', '@song.Artist?.ArtistName', '@song.AudioFileUrl', '@(song.CoverImageUrl ?? "/images/default-cover.jpg")')">
                                    <i class="fas fa-play"></i> Phát
                                </button>
                                <a href="@Url.Action("Details", new { id = song.SongId })" class="btn btn-outline-primary">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <nav class="mt-5">
                <ul class="pagination justify-content-center">
                    @if (currentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?page=@(currentPage - 1)@(string.IsNullOrEmpty(search) ? "" : "&search=" + search)@(genreId.HasValue ? "&genreId=" + genreId : "")">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                    }

                    @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="?page=@i@(string.IsNullOrEmpty(search) ? "" : "&search=" + search)@(genreId.HasValue ? "&genreId=" + genreId : "")">
                                @i
                            </a>
                        </li>
                    }

                    @if (currentPage < totalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?page=@(currentPage + 1)@(string.IsNullOrEmpty(search) ? "" : "&search=" + search)@(genreId.HasValue ? "&genreId=" + genreId : "")">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-music" style="font-size: 5rem; color: var(--text-secondary); opacity: 0.3;"></i>
            <h3 class="mt-3">Không tìm thấy bài hát nào</h3>
            <p class="text-muted">Thử tìm kiếm với từ khóa khác hoặc thay đổi bộ lọc</p>
            <a href="@Url.Action("Index")" class="btn btn-primary mt-3">
                <i class="fas fa-redo"></i> Xem tất cả bài hát
            </a>
        </div>
    }
</div>

<style>
    .pagination .page-link {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--text-primary);
        margin: 0 0.25rem;
        border-radius: 8px;
    }

    .pagination .page-link:hover {
        background: var(--primary-color);
        border-color: var(--primary-color);
        color: white;
    }

    .pagination .page-item.active .page-link {
        background: var(--primary-color);
        border-color: var(--primary-color);
    }
</style>
